<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f0f0f"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛰️ Suto - Full Monitoring"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Device ID: Loading..."
            android:textColor="#aaaaaa"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status Loading..."
            android:textColor="#ffffff"
            android:background="#1f1f1f"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:textSize="11sp"/>

        <!-- Location + Battery + Mobile Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="#1a1a2e"
                android:text="🔋 Battery\n--%"
                android:textColor="#ffffff"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvMobile"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="#16213e"
                android:text="📞 Mobile\nLoading..."
                android:textColor="#ffffff"
                android:padding="8dp"
                android:layout_marginStart="4dp"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2a2a2a"
            android:text="📍 Location: Loading... (Grant permission)"
            android:textColor="#ffffff"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1f1f1f"
            android:text="📊 Device Health Loading..."
            android:textColor="#cccccc"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:textSize="11sp"
            android:fontFamily="monospace"/>

        <!-- Booking Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Service Booking (Test)"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Aapka Naam"
                android:textColor="#ffffff"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:inputType="phone"
                android:textColor="#ffffff"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kaunsi Service?"
                android:textColor="#ffffff"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBook"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Book Karo (GitHub + Telegram)"
            app:cornerRadius="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- SOS + Remote Features -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSOS"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🆘 SOS Panic"
                android:backgroundTint="#d32f2f"
                app:cornerRadius="10dp"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshAll"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="🔄 Refresh All"
                android:backgroundTint="#333333"
                app:cornerRadius="10dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long press status text = Force refresh + Location\n\nFeatures Added: ✅ Battery Graph ✅ Location History Map ✅ Remote Ring (/ring) ✅ Device Health (RAM/Storage/WiFi) ✅ Notification Forward ✅ SOS Panic ✅ Remote Commands (/locate) ✅ Mobile + Location + Battery\n\nGitHub PAT revoked hai - naya banao production ke liye\nTesting Token: 8670... (badalna hai)\nConsole: dthakur-dt.github.io/Suto/"
            android:textColor="#888888"
            android:textSize="10sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
